---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  path?: string; // canonical path; omit for pages that should not be indexed
  ogType?: string;
  current?: string;
}
const { title, description, path, ogType = "website", current } = Astro.props;
const url = path && new URL(path, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{url ? <link rel="canonical" href={url}> : <meta name="robots" content="noindex">}
<link rel="icon" href="/mark.svg" type="image/svg+xml">
<meta name="theme-color" content="#0b0d0c">
{url && (
  <>
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content="Reapr">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description}>}
    <meta name="twitter:card" content="summary">
  </>
)}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Header current={current} />
<main id="main">
<slot />
</main>
<Footer />
<script>
// Copy buttons: each button[data-copy] copies the text of the element whose id it names.
(() => {
  const buttons = document.querySelectorAll("button[data-copy]");
  if (!buttons.length || !navigator.clipboard) return;
  const status = document.createElement("div");
  status.className = "visually-hidden";
  status.setAttribute("role", "status");
  document.body.append(status);
  for (const button of buttons) {
    const target = document.getElementById(button.dataset.copy);
    if (!target) continue;
    const label = button.firstChild;
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(target.innerText.trim());
        label.textContent = "Copied";
        status.textContent = "Copied to the clipboard.";
      } catch {
        label.textContent = "Copy failed";
        status.textContent = "Copy failed. Select the text and copy it.";
      }
      setTimeout(() => { label.textContent = "Copy"; status.textContent = ""; }, 2000);
    });
  }
})();
</script>
</body>
</html>
