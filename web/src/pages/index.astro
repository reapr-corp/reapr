---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Measurement from "../components/Measurement.astro";
import Why from "../components/Why.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Output from "../components/Output.astro";
import Action from "../components/Action.astro";
import Principles from "../components/Principles.astro";
import Engines from "../components/Engines.astro";
import OpenCore from "../components/OpenCore.astro";
import FinalCta from "../components/FinalCta.astro";
---
<Base
  title="Reapr: mutation testing scoped to your pull request diff"
  description="Reapr runs your own StrykerJS config on the lines your pull request changed and reports the mutation score of the diff, with surviving mutants as JSON for people and agents. Open source CLI and GitHub Action."
  path="/"
>
  <Hero />
  <Measurement />
  <Why />
  <HowItWorks />
  <Output />
  <Action />
  <Principles />
  <Engines />
  <OpenCore />
  <FinalCta />
</Base>
