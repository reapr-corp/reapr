// Static site for https://reapr.dev, served by Workers static assets. No Worker script.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reapr-web",
  "account_id": "3838652891727c2e11102b2d38139466",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "reapr.dev", "custom_domain": true },
    { "pattern": "www.reapr.dev", "custom_domain": true }
  ],
  // Serve only the custom domains, not *.workers.dev.
  "workers_dev": false
}
